.page {
  padding-bottom: 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left {
  display: flex;
  align-items: center;
  min-width: 120rpx;
}

.nav-back {
  font-size: 48rpx;
  color: #333;
  line-height: 1;
  margin-right: 8rpx;
}

.nav-back-text {
  font-size: 28rpx;
  color: #333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-right {
  min-width: 120rpx;
}

.header-card {
  margin-top: 0;
  display: flex;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.header-card .thumb {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #eee;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-card .thumb image {
  width: 100%;
  height: 100%;
}

.header-card .placeholder {
  color: #999;
  font-size: 24rpx;
}

.header-card .brief {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.header-card .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.header-card .price {
  font-size: 36rpx;
  font-weight: 600;
  color: #f44;
  display: block;
  margin-bottom: 16rpx;
}

.header-card .meta {
  font-size: 24rpx;
  color: #666;
}

.header-card .meta .item {
  display: block;
  margin-bottom: 8rpx;
}

.header-card .cert-block {
  margin-top: 4rpx;
}

.header-card .meta .item.cert {
  color: #c45c26;
  font-weight: 500;
}

.header-card .cert-note {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.detail-section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.detail-section .row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.detail-section .row .label {
  color: #666;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.detail-section .row .value {
  color: #333;
  text-align: right;
  word-break: break-all;
}

.detail-section .row .value.highlight {
  color: #f44;
  font-weight: 600;
}

.detail-section .cert-row .cert-value {
  color: #c45c26;
  font-weight: 500;
}

.detail-section .cert-note-block {
  display: block;
  font-size: 22rpx;
  color: #999;
  padding: 8rpx 0 16rpx;
}

.detail-section .amount-row {
  border-bottom: none;
}

.quantity-section {
  background: #fff;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.q-row:last-child {
  border-bottom: none;
}

.q-label {
  font-size: 28rpx;
  color: #333;
}

.q-value {
  font-size: 28rpx;
  color: #333;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.stepper-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}

.btn.primary {
  background: #07c160;
  color: #fff;
}

.empty {
  padding: 80rpx;
  text-align: center;
  color: #999;
}
