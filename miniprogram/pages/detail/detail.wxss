.page {
  padding-bottom: 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 自定义导航栏：左上角返回 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left {
  display: flex;
  align-items: center;
  min-width: 120rpx;
}

.nav-back {
  font-size: 48rpx;
  color: #333;
  line-height: 1;
  margin-right: 8rpx;
}

.nav-back-text {
  font-size: 28rpx;
  color: #333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-right {
  min-width: 120rpx;
}

/* 顶部卡片：图+简要信息（货号只在此处） */
.header-card {
  margin-top: 0;
  display: flex;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.header-card .thumb {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #eee;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-card .thumb image {
  width: 100%;
  height: 100%;
}

.header-card .placeholder {
  color: #999;
  font-size: 24rpx;
}

.header-card .brief {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.header-card .name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.header-card .price {
  font-size: 36rpx;
  font-weight: 600;
  color: #f44;
  display: block;
  margin-bottom: 16rpx;
}

.header-card .meta {
  font-size: 24rpx;
  color: #666;
}

.header-card .meta .item {
  display: block;
  margin-bottom: 6rpx;
}

/* 数量选择区（总箱数、每箱数量、购买数量） */
.quantity-section {
  background: #fff;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.q-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.q-row:last-child {
  border-bottom: none;
}

.q-label {
  font-size: 28rpx;
  color: #333;
}

.q-value {
  font-size: 28rpx;
  color: #333;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.stepper-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}

/* 主区域保留：每箱重量、总价格 */
.summary-section {
  background: #fff;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.summary-row .label {
  color: #666;
}

.summary-row .value {
  color: #333;
}

.summary-row .value.highlight {
  color: #f44;
  font-weight: 600;
}

/* 折叠：更多详情 */
.collapse-section {
  background: #fff;
  margin-bottom: 16rpx;
}

.collapse-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.collapse-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.collapse-arrow {
  font-size: 36rpx;
  color: #999;
  transform: rotate(0deg);
  transition: transform 0.2s;
}

.collapse-arrow.open {
  transform: rotate(90deg);
}

.collapse-body {
  padding: 0 24rpx 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  font-size: 28rpx;
}

.row .label {
  color: #999;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.row .value {
  color: #333;
  text-align: right;
  word-break: break-all;
}

.row .value.highlight {
  color: #f44;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}

.btn.primary {
  background: #07c160;
  color: #fff;
}

.empty {
  padding: 80rpx;
  text-align: center;
  color: #999;
}
