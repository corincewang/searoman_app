.page { padding-bottom: 120rpx; background: #f5f5f5; min-height: 100vh; }
.thumb { width: 100%; height: 400rpx; background: #eee; display: flex; align-items: center; justify-content: center; }
.thumb image { width: 100%; height: 100%; }
.placeholder { color: #999; }
.section { background: #fff; margin: 20rpx; padding: 24rpx; border-radius: 16rpx; }
.name { font-size: 36rpx; font-weight: 600; color: #333; display: block; margin-bottom: 24rpx; }
.row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; }
.row .label { color: #999; }
.row .value { color: #333; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx; background: #fff; }
.btn.primary { background: #07c160; color: #fff; }
.empty { padding: 80rpx; text-align: center; color: #999; }
