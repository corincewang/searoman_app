<view class="page" wx:if="{{product}}">
  <view class="thumb">
    <image wx:if="{{product.photo}}" src="{{product.photo}}" mode="aspectFit"/>
    <view wx:else class="placeholder">暂无图片</view>
  </view>
  <view class="section">
    <text class="name">{{product.nameCn}}</text>
    <view class="row"><text class="label">单价</text><text class="value">¥{{product.price}}</text></view>
    <view class="row"><text class="label">规格</text><text class="value">{{product.size || '-'}}</text></view>
    <view class="row"><text class="label">颜色</text><text class="value">{{product.color || '-'}}</text></view>
    <view class="row"><text class="label">材质</text><text class="value">{{product.material || '-'}}</text></view>
    <view class="row"><text class="label">货号</text><text class="value">{{product.itemNo}}</text></view>
    <view class="row"><text class="label">条形码</text><text class="value">{{product.barcode || '-'}}</text></view>
    <view class="row"><text class="label">证书</text><text class="value">{{product.certificate || '-'}}</text></view>
    <view class="row"><text class="label">店铺</text><text class="value">{{product.shopNo}}</text></view>
    <view class="row"><text class="label">订货箱数</text><text class="value">{{product.cartons}}</text></view>
    <view class="row"><text class="label">装箱数/箱</text><text class="value">{{product.pcsInCarton}}</text></view>
    <view class="row"><text class="label">总数量</text><text class="value">{{product.totalQty}}</text></view>
    <view class="row"><text class="label">金额</text><text class="value">¥{{product.amount}}</text></view>
    <view class="row"><text class="label">单箱毛重(KG)</text><text class="value">{{product.grossWeightKg}}</text></view>
    <view class="row"><text class="label">箱规(长×宽×高 cm)</text><text class="value">{{product.cartonLongCm}}×{{product.cartonWideCm}}×{{product.cartonHighCm}}</text></view>
    <view class="row"><text class="label">单箱体积(m³)</text><text class="value">{{product.cubeM3}}</text></view>
  </view>
  <view class="bottom-bar">
    <button class="btn primary" bindtap="addToCart">加入购物车</button>
  </view>
</view>
<view class="empty" wx:else>商品不存在</view>
