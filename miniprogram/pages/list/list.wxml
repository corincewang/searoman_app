<view class="page">
  <view class="top-fixed">
    <!-- 搜索 -->
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜索货号、店铺、名称…"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
    </view>

    <view class="batch-bar" wx:if="{{batchOptions.length > 0}}">
      <button class="batch-btn" size="mini" bindtap="prevBatch" disabled="{{selectedBatchIndex <= 0}}">上页</button>
      <picker mode="selector" range="{{batchOptions}}" range-key="label" value="{{selectedBatchIndex}}" bindchange="onBatchPickerChange">
        <view class="batch-center">
          <text class="batch-title">{{batchOptions[selectedBatchIndex].label}}</text>
        </view>
      </picker>
      <button class="batch-btn" size="mini" bindtap="nextBatch" disabled="{{selectedBatchIndex >= batchOptions.length - 1}}">下页</button>
    </view>
  </view>

  <!-- 淘宝式卡片列表 -->
  <view class="list" wx:if="{{products.length > 0}}">
    <view
      class="card"
      wx:for="{{products}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      hover-class="card-hover"
    >
      <view class="thumb">
        <image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFit" hover-class="none"/>
        <view wx:else class="placeholder">暂无图</view>
      </view>
      <view class="info">
        <view class="name-wrap">
          <text class="name name-cn">{{item.nameCn}}</text>
          <text class="name name-en" wx:if="{{item.nameEn}}">{{item.nameEn}}</text>
        </view>
        <text class="spec">{{item.color || ''}} {{item.size || ''}}</text>
        <view class="row">
          <text class="price">¥{{item.price}}</text>
        </view>
        <view class="shop-wrap">
          <text class="shop-line">店铺 {{item.shopNo}}</text>
          <text class="shop-line">货号 {{item.itemNo}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="load-more" wx:if="{{products.length > 0}}">
    <text wx:if="{{hasMore}}">上拉加载更多（{{loadedCount}} / {{totalInBatch}}）</text>
    <text wx:else>已加载完当前文件（{{totalInBatch}} 条）</text>
  </view>

  <view class="empty" wx:else>
    <text>暂无商品，请到「上传」tab 上传装箱单 Excel</text>
    <button type="primary" bindtap="goUpload">去上传</button>
  </view>
</view>
