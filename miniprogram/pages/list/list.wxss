.page {
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-input {
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.toolbar {
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sort .label {
  color: #666;
  margin-right: 12rpx;
}

.sort .tab {
  margin-right: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #eee;
  color: #333;
}

.sort .tab.active {
  background: #07c160;
  color: #fff;
}

.filter label {
  font-size: 26rpx;
  color: #666;
}

.list {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: space-between;
}

.card {
  width: 340rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.card .thumb {
  width: 100%;
  height: 340rpx;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card .thumb image {
  width: 100%;
  height: 100%;
}

.card .thumb .placeholder {
  color: #999;
  font-size: 28rpx;
}

.card .info {
  padding: 20rpx;
}

.card .name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card .spec {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.card .row {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card .price {
  font-size: 32rpx;
  color: #f44;
  font-weight: 600;
}

.card .qty {
  font-size: 24rpx;
  color: #999;
}

.card .shop {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-top: 8rpx;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
}

.empty button {
  margin-top: 32rpx;
}
