.page { padding-bottom: 120rpx; min-height: 100vh; background: #f5f5f5; }
.list { padding: 20rpx; }
.item { background: #fff; padding: 24rpx; margin-bottom: 20rpx; border-radius: 12rpx; }
.item .name { display: block; font-size: 30rpx; color: #333; }
.item .spec { display: block; font-size: 24rpx; color: #999; margin-top: 8rpx; }
.empty { padding: 80rpx; text-align: center; color: #999; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx; background: #fff; }
