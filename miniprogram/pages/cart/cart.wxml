<view class="page">
  <view class="list" wx:if="{{items.length > 0}}">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <text class="name">{{item.nameCn}}</text>
      <text class="spec">{{item.color}} {{item.size}} ¥{{item.price}} ×{{item.totalQty}} 金额 ¥{{item.amount}}</text>
    </view>
  </view>
  <view class="empty" wx:else>购物车为空，去列表加购</view>
  <view class="bottom-bar" wx:if="{{items.length > 0}}">
    <button bindtap="exportExcel">导出 Excel</button>
  </view>
</view>
