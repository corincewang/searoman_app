.page {
  padding: 32rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section .tip {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.section button {
  margin-top: 0;
}

.file-list {
  margin-top: 16rpx;
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.file-item .file-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.file-item .file-time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.empty-files {
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}
